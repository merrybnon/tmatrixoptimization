__pycache__/
*.py[cod]
.pixi/
.snakemake/
*.egg-info/

# Raw drops are committed, so a clone carries the exact data a run trained on.
# Processed arrays and run output are derived and regenerable, so they are not.
data/*
!data/raw/
!data/processed/
data/processed/*
!data/processed/.gitkeep
results/*
!results/.gitkeep
